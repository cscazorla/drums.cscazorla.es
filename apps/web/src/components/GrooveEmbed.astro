---
interface Props {
  payload: string
  title: string
}

const { payload, title } = Astro.props

// Sin `?ro=1` a propósito: ese flag oculta LOOP, SWING, SPEED trainer, METRO y
// COUNT-IN, que son justo las herramientas de práctica. (No desactiva el play,
// pese a lo que sugiere el README de upstream.)
const src = `/groove/#/embed/g/${payload}`
---

<div class="embed-frame">
  <!-- Sin loading="lazy": es el contenido principal de la página y cargarlo de
       inmediato hace determinista el momento del evento `load`. -->
  <iframe data-groove src={src} title={`Partitura: ${title}`} height="400" allow="autoplay"
  ></iframe>
</div>

<script>
  // El embed de Groove emite `groove:resize`, pero en la práctica manda un
  // único mensaje con height:0 y no vuelve a emitir. Como lo servimos desde
  // nuestro propio origen (/groove/), medimos el documento interno nosotros.
  const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-groove]')

  const fit = (frame: HTMLIFrameElement) => {
    const doc = frame.contentDocument
    // about:blank es el documento inicial del iframe, todavía no el embed.
    if (!doc?.body || doc.location.href === 'about:blank') return
    const height = Math.ceil(doc.body.scrollHeight)
    if (height > 0) frame.style.height = `${height}px`
  }

  /**
   * Bug de upstream: en móvil el embed se queda sin botón de play.
   *
   * Groove oculta el play de `Transport.vue` por debajo de 768px
   * (`hidden md:inline-flex`) porque en el editor lo sustituye el botón de
   * zona de pulgar de `StateBar.vue` (`md:hidden`). Pero `EmbedView.vue`
   * renderiza `Transport` y NO `StateBar`, así que en pantallas estrechas
   * desaparecen los dos y sólo queda Loop.
   *
   * Lo compensamos desde aquí en vez de parchear el submodule. Si upstream
   * lo arregla, este override deja de hacer falta y se puede borrar.
   */
  /**
   * Bug de upstream: en móvil el embed se queda sin botón de play.
   *
   * Groove oculta el play de `Transport.vue` por debajo de 768px
   * (`hidden md:inline-flex`) porque en el editor lo sustituye el botón de
   * zona de pulgar de `StateBar.vue` (`md:hidden`). Pero `EmbedView.vue`
   * renderiza `Transport` y NO `StateBar`, así que en pantallas estrechas
   * desaparecen los dos y sólo queda Loop.
   *
   * Lo compensamos desde aquí en vez de parchear el submodule. Si upstream
   * lo arregla, este override deja de hacer falta y se puede borrar.
   *
   * (Lo de un compás por fila NO se hace aquí: sale del ancho del embed, que
   * `.embed-frame` capa en global.css.)
   */
  const restoreMobilePlay = (doc: Document) => {
    if (doc.getElementById('drums-mobile-play-fix')) return
    const style = doc.createElement('style')
    style.id = 'drums-mobile-play-fix'
    style.textContent =
      '@media (max-width: 767.98px) { .transport-play { display: inline-flex !important; } }'
    doc.head.appendChild(style)
  }

  /**
   * Redimensionar el iframe desde fuera no dispara el redibujado de la
   * partitura, así que se quedaría con el ancho anterior y el navegador la
   * escalaría (se ve diminuta al estrechar). El `redraw` de Groove sí escucha
   * `resize` en su ventana, así que se lo lanzamos nosotros.
   */
  const redrawScore = (frame: HTMLIFrameElement) => {
    const win = frame.contentWindow
    if (win) win.dispatchEvent(new win.Event('resize'))
  }

  for (const frame of frames) {
    const attach = () => {
      const doc = frame.contentDocument
      if (!doc?.body || doc.location.href === 'about:blank') return

      restoreMobilePlay(doc)
      fit(frame)

      // VexFlow pinta la partitura de forma asíncrona después del load, y en
      // carga en frío el bundle tarda. Reintentar unas cuantas veces cubre esa
      // carrera sin recurrir a un polling permanente.
      for (const delay of [0, 100, 300, 800, 2000]) {
        setTimeout(() => fit(frame), delay)
      }

      // Y a partir de ahí, reaccionar a cualquier reflow (cambio de ancho de
      // ventana, rotación del móvil). Observamos los dos elementos porque el
      // alto puede crecer en `html` sin que cambie el borde de `body`.
      const observer = new ResizeObserver(() => fit(frame))
      observer.observe(doc.body)
      observer.observe(doc.documentElement)
    }

    frame.addEventListener('load', attach)
    // Si el iframe ya había cargado cuando corrió este script.
    attach()
  }

  // Al cambiar el ancho de la ventana el iframe cambia de tamaño, así que la
  // partitura tiene que rehacerse antes de volver a medir la altura.
  window.addEventListener('resize', () => {
    for (const frame of frames) {
      redrawScore(frame)
      fit(frame)
    }
  })
</script>
