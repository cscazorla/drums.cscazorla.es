---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const fullTitle = title === 'drums.cscazorla.es' ? title : `${title} — drums.cscazorla.es`

// El nombre del sitio sólo es el encabezado de la página en el índice. En las
// fichas el <h1> es el título del ejercicio, así que aquí baja a <p> y no hay
// dos <h1> compitiendo.
const isHome = Astro.url.pathname === '/'
const Brand = isHome ? 'h1' : 'p'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Antes de renderizar: evita el flash de tema claro en modo oscuro. -->
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* Editable con la extensión draw.io de VS Code: el diagrama va dentro del
        atributo `content`, que el navegador ignora. Un color único a propósito,
        para que draw.io pueda guardarlo sin perder nada — ver el README. */}
    <link rel="icon" href="/favicon.drawio.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <Brand class="brand"><a href="/">drums.cscazorla.es</a></Brand>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        Editor de grooves por
        <a href="https://github.com/fguisso/groove">fguisso/groove</a> (GPL-3.0).
      </footer>
    </div>
  </body>
</html>
